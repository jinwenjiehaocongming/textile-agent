# 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 git 忽略，绝不上传）
# 官方 DeepSeek API：
DEEPSEEK_API_KEY=sk-your-official-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# opencode 网关（可选，替代官方直连）：
# DEEPSEEK_API_KEY=sk-your-opencode-key
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# 离线模式：配置为 1 表示强制 HuggingFace 离线（需已有模型缓存）
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# 可选：LangSmith 追踪
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# ── 鉴权 ──
# DEV_MODE=1：注册 /dev/login（mock 身份切换，本地演示用）；生产不设置
DEV_MODE=1
# JWT 签名密钥：必须设置强随机值（openssl rand -hex 32），生产走 KMS/密钥管理
JWT_SECRET=change-me-to-a-random-hex-64
# ── 企业级演进（2026-08）：PostgreSQL 业务库 + Qdrant 向量库 ──
# PostgreSQL（业务数据：产品/订单/退款/记忆）。本机默认：当前系统用户 + study1 库。
# 生产替换为托管实例连接串（RDS/云 PG）。
DATABASE_URL=postgresql+asyncpg://rain@localhost:5432/study1
# Qdrant：不设置 → LocalMode（index/qdrant_storage，本地嵌入式，零依赖）；
# 生产设置为独立服务地址（并发/多租户/水平扩展）。
# QDRANT_URL=http://localhost:6333

# ── L1 热缓存：Redis（2026-09 规范化；不设置 REDIS_URL 时默认连本机 6379）──
# 连不上/未安装 redis 客户端 → 自动降级进程内 LRU（功能不变，只是慢一点）。
# 生产建议：独立实例 + 密码（redis://:password@host:6379/0）+ maxmemory-policy allkeys-lru
# REDIS_URL=redis://localhost:6379/0
# 0 = 完全不用 Redis（强制进程内缓存，本地排查用）
# REDIS_ENABLED=1
# key 过期秒数（默认 3600）
# REDIS_CACHE_TTL=3600
# 每会话缓存条数上限（默认 50，必须 ≥ 调用方最大的 load_recent n）
# CHAT_CACHE_MAXLEN=50
# key 命名空间前缀（默认 study1；多环境共用一个实例时靠它防串数据）
# REDIS_KEY_PREFIX=study1
# 单次读写/连接超时秒数（默认 1.5）与熔断冷却秒数（默认 10）
# REDIS_SOCKET_TIMEOUT=1.5
# REDIS_FAIL_COOLDOWN=10

# ── 凭证体系（2026-09 路线②：短期 access + 可轮换 refresh）──
# ⚠️ 生产必须给 Redis 开持久化（AOF）：study1:auth:* 是会话数据，丢了等于全员掉线；
#    而 study1:chat:* 是纯缓存，丢了回源 PG 即可 —— 两类数据运维等级不同，
#    生产建议独立实例/独立 db（缓存 /0、会话 /1）。
# access token 寿命（分钟）：默认 15。越短撤销窗口越小，代价是刷新更频繁
# ACCESS_TOKEN_TTL_MINUTES=15
# refresh 空闲期（天）：用一次续一次，默认 14
# REFRESH_IDLE_DAYS=14
# refresh 绝对上限（天）：自登录起算，到点必须重新登录，默认 30
# REFRESH_ABSOLUTE_DAYS=30
# 轮换竞态宽限（秒）：并发刷新时允许旧 refresh 在窗口内再用一次，默认 30
#   （Okta 的 rotation leeway 0–60s 同理；前端单飞才是第一道防线）
# REFRESH_ROTATION_LEEWAY_SECONDS=30
# JWT 签发方/受众（防跨系统 token 串用）与时钟偏移容忍（秒）
# JWT_ISSUER=study1
# JWT_AUDIENCE=study1-web
# JWT_LEEWAY_SECONDS=30

# ── 秒级吊销：凭证版本校验（2026-09）──
# 改密码/封号/全端下线时 token_version +1 → **之前签发的 access token 立刻失效**
# （access 无状态本来撤不了，靠版本号对不上来判定）。代价是每个请求多一步校验，
# 用 60 秒读穿缓存摊薄：绝大多数请求只命中进程内缓存（零 IO）。
# 撤销窗口 = min(access TTL, 缓存 TTL) ≈ 60 秒；设 0 = 关闭校验，回到"热路径零查询"
# 但撤销窗口退回一个 access TTL（15 分钟）。
# AUTH_REVOCATION_CHECK=1
# AUTH_VERSION_CACHE_SECONDS=60
# 读不到版本时的"未知"标记缓存秒数（防故障期间每请求重试 Redis+DB）
# AUTH_VERSION_FAIL_CACHE_SECONDS=10

# ── 限流（Redis 令牌桶；用于 /auth/* 防暴力破解）──
# 桶按维度隔离：IP / 账号+IP / 会话。Redis 不可用时本层 fail-open（放行）
# RL_LOGIN_IP_CAPACITY=20           # 同 IP 每分钟登录次数上限
# RL_LOGIN_FAIL_CAPACITY=5          # 同 账号+IP 的登录失败上限（超出锁定，默认 15 分钟窗口）
# RL_REGISTER_IP_CAPACITY=10        # 同 IP 每小时注册上限
# RL_REFRESH_SESSION_CAPACITY=60    # 单会话每分钟刷新上限
# RL_CHAT_USER_CAPACITY=30          # 每用户每分钟消息数（/chat、/chat/stream，按 user_id 计）
#   为什么业务接口按 user_id 而不是 IP：登录时还不知道用户是谁，只能按 IP；
#   而 /chat 已从 JWT 拿到 user_id，按身份计账才准（换 IP 绕不过、NAT 下不误伤同事）
# 反向代理后面部署时注意：限流取的是 TCP 对端 IP（不信任 X-Forwarded-For，防伪造绕过）

# ── 管理员数据分析 Agent（2026-09）──
# 分析 Agent 执行的是 **LLM 生成的 SQL**（不可信输入），所以要用**只有 SELECT 权限**
# 的角色（四层防护的第一层，也是最后一道兜底）：
#   python scripts/create_analytics_role.py      # 幂等创建角色并打印下面这行
# 不配也能跑（还剩事务只读/语句校验/结果封顶三层），但生产建议配。
# ANALYTICS_DATABASE_URL=postgresql+asyncpg://analytics_ro:<password>@localhost:5432/study1
# 结果封顶与超时（防"LLM 生成全表扫描把库拖垮"）
# ANALYTICS_MAX_ROWS=2000
# ANALYTICS_TIMEOUT_MS=15000
# 规划步数上限（每步约 2 次 LLM 调用，单次 10-30 秒；步数是延迟主因）与 LLM 超时
# ANALYTICS_MAX_STEPS=2
# ANALYTICS_LLM_TIMEOUT=90
# 分析请求限流（一次分析 ≈ 5 次 LLM + 若干只读 SQL，比聊天贵得多）
# RL_ANALYTICS_USER_CAPACITY=10

# ── HITL 待审批订单（2026-09 迁到 PG）──
# 待审批单的存活时间（小时）：超时后惰性标记 expired，不再出现在待审批列表、
# 也不能再被审批（防"三天前的单今天被批"生成幽灵订单）。默认 24。
# APPROVAL_TTL_HOURS=24
# resume 重放识别窗口（秒）：管理员点"通过"与图被恢复之间只隔毫秒级，
# 窗口内出现的"刚判定行"一定重放（复用而不是新建待审批）。默认 120。
# APPROVAL_REPLAY_WINDOW_SECONDS=120

# ── 管理员账号（scripts/create_admin.py 读取，幂等创建/重置；生产必改强密码）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<强密码，至少8位>
ADMIN_NAME=管理员

# Rerank 总开关：1=开（本地 CrossEncoder ~1GB 或接重排 API）；0/缺省=关（仅混合检索）
RERANK_ENABLED=0
