# 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 git 忽略，绝不上传）
# 官方 DeepSeek API：
DEEPSEEK_API_KEY=sk-your-official-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# opencode 网关（可选，替代官方直连）：
# DEEPSEEK_API_KEY=sk-your-opencode-key
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# 离线模式：配置为 1 表示强制 HuggingFace 离线（需已有模型缓存）
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# 可选：LangSmith 追踪
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# ── 鉴权 ──
# DEV_MODE=1：注册 /dev/login（mock 身份切换，本地演示用）；生产不设置
DEV_MODE=1
# JWT 签名密钥：必须设置强随机值（openssl rand -hex 32），生产走 KMS/密钥管理
JWT_SECRET=change-me-to-a-random-hex-64
# ── 企业级演进（2026-08）：PostgreSQL 业务库 + Qdrant 向量库 ──
# PostgreSQL（业务数据：产品/订单/退款/记忆）。本机默认：当前系统用户 + study1 库。
# 生产替换为托管实例连接串（RDS/云 PG）。
DATABASE_URL=postgresql+asyncpg://rain@localhost:5432/study1
# Qdrant：不设置 → LocalMode（index/qdrant_storage，本地嵌入式，零依赖）；
# 生产设置为独立服务地址（并发/多租户/水平扩展）。
# QDRANT_URL=http://localhost:6333
